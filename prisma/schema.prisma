// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model User {
  id           String           @id @default(cuid())
  name         String?
  email        String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]

  connectionsSent     Connection[] @relation("ConnectionRequester")
  connectionsReceived Connection[] @relation("ConnectionAddressee")
  messagesSent        Message[]    @relation("MessageSender")
  messagesReceived    Message[]    @relation("MessageRecipient")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  succeeded Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model JobApplication {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  jobTitle       String
  jobDescription String  @default("")
  aboutCompany   String?
  status         ApplicationStatus @default(APPLIED)
  outcomeNotes   String?
  appliedAt      DateTime          @default(now())
  followUpAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  links         Link[]
  resume        Resume?
  statusHistory StatusHistory[]

  @@index([userId])
}

model Link {
  id               String         @id @default(cuid())
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  label            String
  url              String
  createdAt        DateTime       @default(now())

  @@index([jobApplicationId])
}

model Resume {
  id               String         @id @default(cuid())
  jobApplicationId String         @unique
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  originalFilename String
  // Vercel Blob URL in production, or a local filename under UPLOAD_DIR
  // when running without a BLOB_READ_WRITE_TOKEN (local dev fallback).
  storageKey       String
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime       @default(now())
}

model StatusHistory {
  id               String            @id @default(cuid())
  jobApplicationId String
  jobApplication   JobApplication    @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  fromStatus       ApplicationStatus?
  toStatus         ApplicationStatus
  note             String?
  changedAt        DateTime          @default(now())

  @@index([jobApplicationId])
}
