# Postgres connection string (e.g. from Neon, Vercel Postgres, Supabase, or a local Postgres).
DATABASE_URL=""

# Auth.js secret used to sign session JWTs. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Vercel Blob token for resume storage in production (Vercel dashboard ->
# Storage -> create a Blob store -> copy the read/write token). If unset,
# resumes are stored on the local filesystem under UPLOAD_DIR instead
# (only works when the filesystem is writable and persistent, i.e. local dev).
BLOB_READ_WRITE_TOKEN=""

# Directory (relative to project root) where uploaded resumes are stored on
# disk when BLOB_READ_WRITE_TOKEN is not set.
UPLOAD_DIR="./uploads"

# Pusher Channels (pusher.com, free tier) for realtime chat + online/offline
# presence. If unset, chat still works but messages only appear on refresh
# instead of instantly, and online indicators won't show.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
# Same key/cluster, exposed to the browser (Pusher's client key is public by design).
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Resend (resend.dev, free tier) for daily follow-up reminder emails. If
# unset, the reminder cron still runs but skips sending (logs a warning).
RESEND_API_KEY=""
# Optional: defaults to Resend's shared test sender, which works without
# verifying your own domain. Replace once you verify a domain in Resend.
EMAIL_FROM="Job Application Tracker <onboarding@resend.dev>"
# Shared secret Vercel Cron sends as a Bearer token; set the same value here
# and in Vercel's project env vars so the cron route rejects other callers.
CRON_SECRET=""
# Optional: canonical app URL used in reminder email links. Defaults to the
# request's own origin, which is correct once deployed on Vercel.
APP_URL=""
