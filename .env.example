# Postgres connection string (e.g. from Neon, Vercel Postgres, Supabase, or a local Postgres).
DATABASE_URL=""

# Auth.js secret used to sign session JWTs. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Vercel Blob token for resume storage in production (Vercel dashboard ->
# Storage -> create a Blob store -> copy the read/write token). If unset,
# resumes are stored on the local filesystem under UPLOAD_DIR instead
# (only works when the filesystem is writable and persistent, i.e. local dev).
BLOB_READ_WRITE_TOKEN=""

# Directory (relative to project root) where uploaded resumes are stored on
# disk when BLOB_READ_WRITE_TOKEN is not set.
UPLOAD_DIR="./uploads"
